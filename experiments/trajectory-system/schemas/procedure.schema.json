{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "procedure",
    "source",
    "triggering_conditions",
    "proposed_transition",
    "authority_class",
    "verifier",
    "rollback",
    "known_failure_modes",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "procedure": {
      "type": "object",
      "required": [
        "id",
        "purpose"
      ]
    },
    "source": {
      "type": "object"
    },
    "triggering_conditions": {
      "type": "array"
    },
    "prohibited_conditions": {
      "type": "array"
    },
    "required_inputs": {
      "type": "array"
    },
    "inspected_preconditions": {
      "type": "array"
    },
    "proposed_transition": {
      "type": "object"
    },
    "authority_class": {
      "type": "string"
    },
    "execution_steps": {
      "type": "array"
    },
    "expected_effect": {
      "type": "string"
    },
    "verifier": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    },
    "emitted_trace": {
      "type": "array"
    },
    "known_failure_modes": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "quarantined",
        "revoked"
      ]
    }
  },
  "additionalProperties": true
}
